# Database
DATABASE_URL="postgresql://smartprint:password@localhost:5433/smartprintai?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Google Gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash-image"

# Printful
PRINTFUL_API_KEY="your-printful-api-key"
PRINTFUL_STORE_ID="your-store-id"
PRINTFUL_WEBHOOK_SECRET="your-printful-webhook-secret-hex"

# Gelato (optional additional catalog provider)
GELATO_API_KEY=""
GELATO_PRODUCTS_BASE_URL="https://product.gelatoapis.com"
GELATO_ECOMMERCE_BASE_URL="https://ecommerce.gelatoapis.com"
GELATO_SYNC_MODE="catalog"
GELATO_CATALOG_UIDS=""
GELATO_SYNC_CATALOG_AUTO_DISCOVER="0"
GELATO_CATALOG_DISCOVERY_LIMIT="100"
GELATO_CATALOG_DISCOVERY_MAX="300"
GELATO_SYNC_APPAREL_ONLY="1"
GELATO_SYNC_GARMENT_CUTS="mens,womens,unisex"
GELATO_SYNC_LIMIT="20"
GELATO_SYNC_OFFSET="0"
GELATO_PRICE_COUNTRY="US"
GELATO_PRICE_CURRENCY="USD"
GELATO_SELL_PRICE_MULTIPLIER="2.2"
GELATO_MIN_MARGIN="8"
GELATO_SYNC_DRY_RUN="1"
GELATO_STORE_ID=""
GELATO_TEMPLATE_MAP_JSON=""

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Storage (MinIO for local, R2 for prod)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="smartprintai"
STORAGE_PUBLIC_URL="http://localhost:9000/smartprintai"

# Resend (email)
RESEND_API_KEY="re_..."
EMAIL_FROM="orders@smartprintai.com"
SUPPORT_EMAIL="support@smartprintai.com"
CONTACT_EMAIL="contact@smartprintai.com"
MARKETING_EMAIL="hello@smartprintai.com"
FIRST_ORDER_COUPON_CODE="WELCOME10"

# Make.com automations
MAKE_ORDER_ALERT_WEBHOOK_URL=""
MAKE_SHIPPED_REVIEW_WEBHOOK_URL=""
MAKE_ABANDONED_CART_WEBHOOK_URL=""
MAKE_DAILY_DIGEST_WEBHOOK_URL=""
MAKE_DESIGN_AUTOPOST_WEBHOOK_URL=""
