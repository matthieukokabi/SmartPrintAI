AUTOMATION_SHARED_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NODE_ENV="development"

# Monitoring (optional)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.0"
# Auth
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
