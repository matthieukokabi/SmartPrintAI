# Database
DATABASE_URL="postgresql://smartprint:password@localhost:5433/smartprintai?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Google Gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash-image"

# Printful
PRINTFUL_API_KEY="your-printful-api-key"
PRINTFUL_STORE_ID="your-store-id"
PRINTFUL_WEBHOOK_SECRET="your-printful-webhook-secret-hex"

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Storage (MinIO for local, R2 for prod)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="smartprintai"
STORAGE_PUBLIC_URL="http://localhost:9000/smartprintai"

# Resend (email)
RESEND_API_KEY="re_..."
EMAIL_FROM="orders@smartprintai.com"
SUPPORT_EMAIL="support@smartprintai.com"
CONTACT_EMAIL="contact@smartprintai.com"
MARKETING_EMAIL="hello@smartprintai.com"
FIRST_ORDER_COUPON_CODE="WELCOME10"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NODE_ENV="development"

# Monitoring (optional)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.0"
# Auth
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
