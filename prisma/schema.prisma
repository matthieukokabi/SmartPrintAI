generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  orders    Order[]
  designs   Design[]
}

model OwnerCredential {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  mustRotatePassword Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Design {
  id         String      @id @default(cuid())
  userId     String?
  sessionId  String?
  prompt     String
  style      String      @default("artistic")
  imageUrl   String
  status     String      @default("ready")
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])
  mockups    Mockup[]
  orderItems OrderItem[]
}

model Product {
  id                      String      @id @default(cuid())
  name                    String
  printfulId              String      @unique
  description             String
  category                String
  basePrice               Float
  sellPrice               Float
  sizes                   String[]
  colors                  Json
  imageUrl                String
  printArea               Json
  active                  Boolean     @default(true)
  nameTranslations        Json?
  descriptionTranslations Json?
  mockups                 Mockup[]
  orderItems              OrderItem[]
}

model Mockup {
  id        String  @id @default(cuid())
  designId  String
  productId String
  color     String  @default("white")
  mockupUrl String
  design    Design  @relation(fields: [designId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([designId, productId, color])
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  sessionId       String?
  email           String
  stripeSessionId String      @unique
  printfulOrderId String?
  status          String      @default("pending")
  internalNotes   String?
  subtotal        Float
  shippingCost    Float       @default(0)
  total           Float
  shippingAddress Json
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  trackingNumber  String?
  trackingCarrier String?
  shippedAt       DateTime?
  trackingUrl     String?
  emailSentAt     DateTime?
  shipmentEmailSentAt DateTime?
  printfulCalledAt DateTime?
  paymentProvider String?
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  designId  String
  size      String
  color     String
  quantity  Int     @default(1)
  price     Float
  mockupUrl String?
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  design    Design  @relation(fields: [designId], references: [id])
}
